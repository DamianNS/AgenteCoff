@page "/"
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>AgenteCoff</PageTitle>

<div class="container py-4">
    <h1>Bienvenido a AgenteCoff</h1>

    <AuthorizeView>
        <Authorized>
            <div class="alert alert-success">
                Estás autenticado como <strong>@UserName</strong>.
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-info">
                Para ver el clima protegido, debes iniciar sesión.
            </div>
        </NotAuthorized>    
    </AuthorizeView>

    <p>Usa el formulario de inicio de sesión para obtener un token JWT y acceder a los recursos protegidos del backend.</p>

    <a class="btn btn-primary" href="/Account/Login">Ir al inicio de sesión</a>
</div>