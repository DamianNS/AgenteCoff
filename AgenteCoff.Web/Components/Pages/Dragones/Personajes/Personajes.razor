

<h2>Lista de Personajes</h2>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Raze</th>
            <th>Class</th>
            <th>Age</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Characters == null || !Characters.Any())
        {
            <tr>
                <td colspan="5">No hay personajes registrados.</td>
            </tr>
        }
        else
        {
            @foreach (var character in Characters)
            {
                <tr>
                    <td>@character.Name</td>
                    <td>@character.Raze</td>
                    <td>@character.Class</td>
                    <td>@character.Age</td>
                    <td>
                        <button class="btn btn-sm btn-warning" @onclick="() => EditCharacter(character)">Modificar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteCharacter(character)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>