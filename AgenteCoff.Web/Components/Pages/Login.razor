@page "/login"
@using AgenteCoff.Web.Services
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Navigation
@inject ApiClient apiClient

<PageTitle>Iniciar sesión</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="mb-4">Iniciar sesión</h1>

                    @if (isAuthenticated)
                    {
                        <div class="alert alert-success">
                            Ya has iniciado sesión como <strong>@userName</strong>.
                        </div>

                        <button class="btn btn-outline-secondary" @onclick="LogoutAsync">
                            Cerrar sesión
                        </button>
                    }
                    else
                    {
                        <form method="post" action="/auth/login">
                            <div class="mb-3">
                                <label class="form-label" for="email">Correo electrónico</label>
                                <input id="email" name="Email" class="form-control" value="@loginModel.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="password">Contraseña</label>
                                <input id="password" name="Password" type="password" class="form-control" value="@loginModel.Password" />
                            </div>

                            <button class="btn btn-primary" type="submit">Iniciar sesión</button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginFormModel loginModel = new();
    private bool isSubmitting;
    private bool isAuthenticated;
    private string? userName;
    private string? errorMessage;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            isAuthenticated = AuthStateTask?.Result.User.Identity?.IsAuthenticated ?? false;
            StateHasChanged();
        }
        
        return base.OnAfterRenderAsync(firstRender);
    }

    private async Task LogoutAsync()
    {
        Navigation.NavigateTo("/auth/logout", forceLoad: true);
    }

    private class LoginFormModel
    {
        public string Email { get; set; } = "admin@agentecoff.local";
        public string Password { get; set; } = "Password123!";
    }
}
