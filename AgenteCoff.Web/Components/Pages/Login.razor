@page "/login"
@inject AuthenticationSessionService AuthService
@inject NavigationManager Navigation

<PageTitle>Iniciar sesión</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="mb-4">Iniciar sesión</h1>

                    @if (isAuthenticated)
                    {
                        <div class="alert alert-success">
                            Ya has iniciado sesión como <strong>@userName</strong>.
                        </div>

                        <button class="btn btn-outline-secondary" @onclick="LogoutAsync">
                            Cerrar sesión
                        </button>
                    }
                    else
                    {
                        <EditForm Model="loginModel" OnValidSubmit="HandleLoginAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="mb-3">
                                <label class="form-label" for="email">Correo electrónico</label>
                                <InputText id="email" class="form-control" @bind-Value="loginModel.Email" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="password">Contraseña</label>
                                <InputText id="password" type="password" class="form-control" @bind-Value="loginModel.Password" />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <div class="alert alert-danger">@errorMessage</div>
                            }

                            <button class="btn btn-primary" type="submit" disabled="@isSubmitting">
                                @(isSubmitting ? "Iniciando sesión..." : "Iniciar sesión")
                            </button>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginFormModel loginModel = new();
    private bool isSubmitting;
    private bool isAuthenticated;
    private string? userName;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await RefreshSessionStateAsync();
    }

    private async Task HandleLoginAsync()
    {
        isSubmitting = true;
        errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(loginModel.Email, loginModel.Password);
            if (result is null)
            {
                errorMessage = "Credenciales inválidas o el servicio no está disponible.";
                return;
            }

            loginModel = new();
            await RefreshSessionStateAsync();
            Navigation.NavigateTo("/weather");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        await RefreshSessionStateAsync();
    }

    private async Task RefreshSessionStateAsync()
    {
        var token = await AuthService.GetTokenAsync();
        isAuthenticated = !string.IsNullOrWhiteSpace(token);
        userName = await AuthService.GetUserNameAsync();
    }

    private class LoginFormModel
    {
        public string Email { get; set; } = "admin@agentecoff.local";
        public string Password { get; set; } = "Password123!";
    }
}
