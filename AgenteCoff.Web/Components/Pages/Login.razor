@page "/Account/Login"

<PageTitle>Iniciar sesión</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="mb-4">Iniciar sesión</h1>

                    @if (isAuthenticated)
                    {
                        <div class="alert alert-success">
                            Ya has iniciado sesión como <strong class="text-dark">@userName</strong>.
                        </div>
                        <button class="btn btn-outline-secondary btn-block mt-3" @onclick="LogoutAsync">
                            Cerrar sesión
                        </button>
                    }
                    else
                    {
                        <form method="post" action="/auth/login" class="mt-4">
                            <div class="mb-3">
                                <label class="form-label" for="email">Correo electrónico</label>
                                <input id="email" name="Email" class="form-control" value="@loginModel.Email" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="password">Contraseña</label>
                                <input id="password" name="Password" type="password" class="form-control" value="@loginModel.Password" required />
                            </div>

                            <button class="btn btn-primary btn-block" type="submit">
                                Iniciar sesión
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>